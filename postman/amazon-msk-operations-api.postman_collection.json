                      "responseTime": null,
                      "body": "{\n  \"ClusterOperationInfo\": {\n    \"ClientRequestId\": \"<string>\",\n    \"ClusterArn\": \"<string>\",\n    \"CreationTime\": \"<dateTime>\",\n    \"EndTime\": \"<dateTime>\",\n    \"ErrorInfo\": {\n      \"ErrorCode\": \"<string>\",\n      \"ErrorString\": \"<string>\"\n    },\n    \"OperationArn\": \"<string>\",\n    \"OperationState\": \"<string>\",\n    \"OperationSteps\": [\n      {\n        \"StepInfo\": {\n          \"StepStatus\": \"<string>\"\n        },\n        \"StepName\": \"<string>\"\n      },\n      {\n        \"StepInfo\": {\n          \"StepStatus\": \"<string>\"\n        },\n        \"StepName\": \"<string>\"\n      }\n    ],\n    \"OperationType\": \"<string>\",\n    \"SourceClusterInfo\": {\n      \"BrokerEBSVolumeInfo\": [\n        {\n          \"KafkaBrokerNodeId\": \"<string>\",\n          \"ProvisionedThroughput\": {\n            \"Enabled\": \"<boolean>\",\n            \"VolumeThroughput\": \"<integer>\"\n          },\n          \"VolumeSizeGB\": \"<integer>\"\n        },\n        {\n          \"KafkaBrokerNodeId\": \"<string>\",\n          \"ProvisionedThroughput\": {\n            \"Enabled\": \"<boolean>\",\n            \"VolumeThroughput\": \"<integer>\"\n          },\n          \"VolumeSizeGB\": \"<integer>\"\n        }\n      ],\n      \"ConfigurationInfo\": {\n        \"Revision\": \"<integer>\",\n        \"Arn\": \"<string>\"\n      },\n      \"NumberOfBrokerNodes\": \"<integer>\",\n      \"EnhancedMonitoring\": \"PER_BROKER\",\n      \"OpenMonitoring\": {\n        \"Prometheus\": {\n          \"JmxExporter\": {\n            \"EnabledInBroker\": \"<boolean>\"\n          },\n          \"NodeExporter\": {\n            \"EnabledInBroker\": \"<boolean>\"\n          }\n        }\n      },\n      \"KafkaVersion\": \"<string>\",\n      \"LoggingInfo\": {\n        \"BrokerLogs\": {\n          \"CloudWatchLogs\": {\n            \"Enabled\": \"<boolean>\",\n            \"LogGroup\": \"<string>\"\n          }